# Supabase — get these from your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Weather — OpenWeatherMap free tier API key (used in Phase 5)
# NEXT_PUBLIC_OPENWEATHER_KEY=your-openweathermap-key-here

# Plaid (get from dashboard.plaid.com)
PLAID_CLIENT_ID=your_client_id
PLAID_SECRET=your_sandbox_secret
PLAID_ENV=production
